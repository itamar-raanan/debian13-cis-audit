<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>CIS Debian 13 Audit - {{ inventory_hostname }}</title>
<style>body{font-family:system-ui,sans-serif;margin:2rem}table{border-collapse:collapse;width:100%}th,td{border:1px solid #ccc;padding:.45rem;text-align:left}th{background:#eee}.PASS{background:#e8f5e9}.FAIL{background:#ffebee}.EXCLUDED{background:#fff8e1}</style></head>
<body>
<h1>CIS Debian Linux 13 Audit</h1>
<p><strong>Host:</strong> {{ inventory_hostname }} | <strong>Profile:</strong> {{ cis_profile }} | <strong>Generated:</strong> {{ ansible_date_time.iso8601 }}</p>
<p>Total {{ cis_summary.total }} | Pass {{ cis_summary.pass }} | Fail {{ cis_summary.fail }} | Manual {{ cis_summary.manual }} | Excluded {{ cis_summary.excluded }} | Error {{ cis_summary.error }}</p>
<table><thead><tr><th>ID</th><th>Title</th><th>Status</th><th>Actual</th></tr></thead><tbody>
{% for result in cis_results %}<tr class="{{ result.status }}"><td>{{ result.id }}</td><td>{{ result.title }}</td><td>{{ result.status }}</td><td>{{ result.actual }}</td></tr>{% endfor %}
</tbody></table></body></html>
